# Cloudflare credentials (required for writing healed links back to KV)
# Get Account ID from the Cloudflare dashboard right-hand sidebar
CF_ACCOUNT_ID=your_account_id_here

# Create an API Token with "Account > Workers KV Storage > Edit" permission
# https://dash.cloudflare.com/profile/api-tokens
CF_API_TOKEN=your_api_token_here

# The ID returned by: npx wrangler kv:namespace create AUTOFIX_KV
CF_KV_NAMESPACE_ID=your_kv_namespace_id_here

# Optional
HEALER_LISTEN=:8080

# OpenTelemetry (optional) — OTLP HTTP endpoint for traces + metrics
# Examples: http://localhost:4318  or  localhost:4318
# When unset, Prometheus /metrics still works; traces stay local no-op exporter
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Phase 7B supervised writes (required for POST /v1/admin/actions)
# Generate a long random token; never commit the real value.
# ADMIN_TOKEN=change-me
