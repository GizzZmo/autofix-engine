{
  "name": "autofix-edge-worker",
  "version": "1.2.0",
  "private": true,
  "description": "AutoFix Cloudflare Worker - HTML streaming rewriter + Queue",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "typecheck": "tsc --noEmit",
    "kv:create": "wrangler kv namespace create AUTOFIX_KV",
    "kv:create-preview": "wrangler kv namespace create AUTOFIX_KV --preview",
    "queues:create": "wrangler queues create autofix-discovery && wrangler queues create autofix-discovery-dlq",
    "setup": "node ../scripts/run-setup.mjs",
    "setup:shell": "bash ../scripts/setup-cloudflare.sh"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240925.0",
    "typescript": "^5.6.2",
    "wrangler": "^3.114.0"
  }
}
